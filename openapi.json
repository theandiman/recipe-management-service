tring","format":"date-time","description":"Recipe creation timestamp","example":"2024-01-15T10:30:00Z"},"updatedAt":{"type":"string","format":"date-time","description":"Recipe last update timestamp","example":"2024-01-15T14:30:00Z"},"tags":{"type":"array","description":"Recipe tags for categorization","example":["Italian","Pasta","Quick"],"items":{"type":"string"}},"dietaryRestrictions":{"type":"array","description":"Dietary restrictions/labels","example":["Gluten-Free","Vegetarian"],"items":{"type":"string"}},"authorDisplayName":{"type":["string","null"],"description":"Display name of the recipe author (populated for public recipes)","example":"Jane Smith"},"likeCount":{"type":"integer","format":"int32","description":"Number of likes this recipe has received","example":42},"public":{"type":"boolean"},"likedByCurrentUser":{"type":"boolean"},"savedByCurrentUser":{"type":"boolean"},"isPublic":{"type":"boolean","description":"Whether the recipe is shared with everyone","example":true},"isSavedByCurrentUser":{"type":"boolean","description":"Whether this recipe is saved/bookmarked by the current authenticated user","example":false},"isLikedByCurrentUser":{"type":"boolean","description":"Whether this recipe is liked by the current authenticated user","example":false}}},"UpdateUserProfileRequest":{"type":"object","properties":{"displayName":{"type":"string","maxLength":50,"minLength":0},"bio":{"type":"string","maxLength":500,"minLength":0},"avatarUrl":{"type":"string","maxLength":1000,"minLength":0},"visibility":{"type":"string","pattern":"^(PUBLIC|PRIVATE)$"}}},"UserProfileResponse":{"type":"object","properties":{"uid":{"type":"string"},"displayName":{"type":"string"},"bio":{"type":"string"},"avatarUrl":{"type":"string"},"visibility":{"type":"string"},"publicRecipeCount":{"type":"integer","format":"int64"},"followerCount":{"type":"integer","format":"int64"},"followingCount":{"type":"integer","format":"int64"},"publicRecipes":{"type":"array","items":{"$ref":"#/components/s